%% data_flow_diagram.mmd
%% LunaSafe — data transformation flow (phase order matches main.py run_pipeline()).

flowchart LR
    subgraph P1["PHASE 1 — Ingest (main.py:85-93)"]
        A1["DEM GeoTIFF"] --> A2["io_utils.inspect_raster<br/>CRS guard + stats<br/>(io_utils.py:191)"]
        A3["PSR GeoTIFF"] --> A4["io_utils.align_psr_to_dem<br/>shape/CRS/transform check<br/>or nearest reprojection<br/>(io_utils.py:288)"]
        A2 --> A5["dem[] float32<br/>psr[] uint8<br/>dem_meta dict"]
        A4 --> A5
    end

    subgraph P2["PHASE 2 — PSR (main.py:98-109)"]
        A5 --> B1["psr.binarize_psr<br/>NoData ⇒ 0<br/>(psr.py:30)"]
        B1 --> B2["psr.clean_psr_mask<br/>8-connected, <9px removed<br/>(psr.py:61)"]
        B2 --> B3["calculate_psr_area ⇒ km²<br/>(psr.py:94)"]
        B2 --> B4["vectorize_psr_to_polygons<br/>⇒ GeoDataFrame<br/>(psr.py:115)"]
        B2 --> B5["psr_binary.tif<br/>psr_polygons.geojson/.shp"]
    end

    subgraph P3["PHASE 3 — Terrain (main.py:114-130)"]
        A5 --> C1["Horn slope + aspect<br/>(terrain.py:21)"]
        A5 --> C2["roughness std 3×3<br/>(terrain.py:90)"]
        A5 --> C3["Riley TRI<br/>(terrain.py:139)"]
        C1 --> C4["slope_deg.tif, aspect_deg.tif"]
        C2 --> C5["roughness_std_m.tif"]
        C3 --> C6["roughness_tri_m.tif"]
        C1 --> C7["terrain_histograms.png"]
    end

    subgraph P4["PHASE 4 — Hazard (main.py:135-147)"]
        C2 --> D1["compute_hazard_score<br/>H = .50·S + .30·R + .20·D<br/>(hazard.py:23)"]
        B2 --> D2["classify_hazard_surface<br/>hard overrides + class order<br/>(hazard.py:61)"]
        C2 --> D2
        D2 --> D3["hazard_classes.tif uint8 0-4"]
        D2 --> D4["hazard_summary.csv<br/>(hazard.py:137)"]
        D1 --> D2
    end

    subgraph P5["PHASE 5 — Cartography (main.py:152-167)"]
        D3 --> E1["generate_4panel_hazard_map<br/>(mapping.py:149)"]
        A5 --> E1
        C1 --> E1
        B4 --> E1
        E1 --> E2["lunasafe_hazard_map.png<br/>lunasafe_hazard_map.pdf"]
    end

    subgraph P6["PHASE 6 — Validation (main.py:172-186)"]
        D3 --> F1["verify_rule_consistency<br/>9 invariants<br/>(validate.py:70)"]
        D1 --> F1
        C2 --> F1
        B2 --> F1
        F1 --> F2["rule_audit {total_violations}"]
        C2 --> F3["run_slope_sensitivity_analysis<br/>5 scenarios<br/>(validate.py:151)"]
        F3 --> F4["slope_sensitivity.png"]
        B2 --> F5["compute_psr_metrics<br/>⚠ self-comparison in pipeline<br/>(validate.py:301)"]
    end

    subgraph P7["PHASE 7 — Autonomy (main.py:191-201)"]
        D3 --> G1["recommend_landing_sites<br/>EDT + fitness map<br/>(ml_recommender.py:84)"]
        A5 --> G1
        C1 --> G1
        C2 --> G1
        B2 --> G1
        A5 --> G2["detect_boulder_micro_hazards<br/>Gaussian bandpass + sigmoid<br/>(ml_recommender.py:18)"]
        G1 --> G3["landing_sites.json"]
        G2 --> G4["boulder_hazard.tif"]
    end

    subgraph WEBFLOW["Web flow (separate process)"]
        H1["outputs/* raster files"] --> H2["export_web_data.export_data_bundle<br/>(export_web_data.py:11)"]
        H2 --> H3["outputs/web_data.json<br/>flat arrays + defaults"]
        H3 -->|GET /api/data| H4["web/app.js loadDataset<br/>offscreen canvases + 3D mesh"]
        H5["RASTER_CACHE (RAM)<br/>(web_server.py:48)"] -->|POST /api/recalculate| H6["hazard.classify_hazard_surface<br/>+ validate.verify_rule_consistency<br/>+ ml_recommender.recommend_landing_sites"]
        H6 --> H7["JSON: summary, hazard_classes_flat,<br/>landing_sites, rule_audit, sensitivity"]
        H7 --> H4
    end

    D3 -.-> H1
    C5 -.-> H1
    B5 -.-> H1
    G3 -.-> H2
    G4 -.-> H1
